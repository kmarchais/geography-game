{
  "name": "geography-game",
  "version": "1.1.0",
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@mdi/font": "7.4.47",
    "@turf/union": "^7.4.0",
    "country-flag-emoji-polyfill": "^0.1.10",
    "google-auth-library": "^11.3.1",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vuetify": "^3.13.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/google.accounts": "^0.0.15",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^4.1.12",
    "@vue/eslint-config-typescript": "14.5.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "postcss-html": "^1.8.1",
    "sass": "^1.106.1",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.4.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "bun@1.2.20",
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint --config eslint.config.cjs . --fix",
    "test": "vitest run --maxWorkers=2",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "update-total-rounds": "bun run scripts/add-total-rounds.ts",
    "validate-total-rounds": "bun run scripts/validate-total-rounds.ts",
    "start": "vite preview --host --port $PORT",
    "test:watch": "vitest --maxWorkers=2",
    "test:globe": "bun run build-only && playwright test --config playwright.globe.config.ts",
    "test:ranking": "node --test tests/server/*.test.mjs",
    "ranking": "node server/ranking.mjs",
    "data:globe": "node scripts/prepare-globe-data.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint:check": "eslint --config eslint.config.cjs .",
    "build:android": "node scripts/build-android.mjs",
    "android:open": "cap open android"
  },
  "type": "module"
}
