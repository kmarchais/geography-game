{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-geography",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/atlas-api", "/atlas-api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ATLAS_DATABASE", "class_name": "AtlasDatabase" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtlasDatabase"] }]
}
